(ns pattern-vm
  ;; The matcher again, over a program carried as a STRING.
  ;;
  ;; ## Why
  ;;
  ;; `pattern-core` carries its program as a `:document`, and a document is
  ;; bounded: depth 8, 256 nodes, and **32 items per container**
  ;; (`osaho/src/kotoba/kir/value.cljc`). Measured 2026-09-09 over the 200
  ;; regex literals in kotoba-lang's browser stack, 43 of them exceed one of
  ;; those. None of them disagreed about MEANING -- every pattern that fits
  ;; produces the identical program -- so the ceiling is the value shape and
  ;; nothing else. A program of more than 32 instructions simply cannot be a
  ;; guest document.
  ;;
  ;; Nor is there anywhere else to put it: every guest container is bounded
  ;; near 32 (typed map 31, typed set 32, record 32 fields, heterogeneous
  ;; vector 32), `[:vector T]` is a bounded TUPLE type, and no backend has a
  ;; sequence parameter type at all. The one unbounded-ish value a guest can
  ;; hold is a `:string` -- 65536 bytes -- so that is where the program goes.
  ;;
  ;; 65536 / 14 is about 4,680 instructions, against 32. The corpus needs 84.
  ;;
  ;; ## The format
  ;;
  ;;   header   "K" fold(1) nc(6 hex) nr(6 hex)                  14 chars
  ;;   code     nc x [ op(1) a(6) b(6) c(1) ]                    14 chars each
  ;;   ranges   nr x [ lo(6) hi(6) ]                             12 chars each
  ;;
  ;;   op 0 char   a = code point        op 4 jmp    a = pc
  ;;   op 1 class  a = first range, b = range count, c = negated
  ;;   op 2 any                          op 6 match
  ;;   op 3 split  a = pc, b = pc        op 7 bol    op 8 eol
  ;;
  ;; Fixed width on purpose: an instruction is addressed by arithmetic, so
  ;; nothing has to be scanned to find it. The class table is inline and an
  ;; instruction names its ranges by (first, count), so there is no second
  ;; indirection to bound either.
  ;;
  ;; ## What this costs
  ;;
  ;; Fuel is charged per function ENTRY and every field is now six hex digits
  ;; read one at a time, so an instruction costs about a dozen entries where
  ;; the document form cost one. That is the trade the ceiling forces, and the
  ;; host chooses the budget (`--fuel`). Nothing else changed: this is
  ;; `pattern-core`'s machine -- a Pike VM with a deduplicated thread list,
  ;; linear in input x program -- reading a different container.
  ;;
  ;; `pattern-core` stays as the oracle: `test/vm_parity.cljs` runs both over
  ;; the same patterns, and the small ones must agree.
  (:export [main
            prog-fold? prog-count range-count
            ins-op ins-a ins-b ins-c range-lo range-hi
            hex-at
            match? search search-start search-end
            test-hex test-header test-literal test-class test-quantifier
            test-alternation test-anchor test-search test-fold test-bounded])
  (:schemas {:pat/hex [:record :pat/hex [[:s :string] [:i :i64] [:n :i64] [:acc :i64]]]
             :pat/add [:record :pat/add
                       [[:prog :string] [:list :string] [:pc :i64]
                        [:bol :bool] [:eol :bool] [:blen :i64]]]
             :pat/threads [:record :pat/threads
                           [[:prog :string] [:list :string] [:i :i64]
                            [:cp :i64] [:next :string] [:blen :i64] [:eol :bool]]]
             :pat/run [:record :pat/run
                       [[:prog :string] [:list :string] [:s :string]
                        [:pos :i64] [:len :i64] [:blen :i64]]]
             :pat/scan [:record :pat/scan
                        [[:prog :string] [:s :string] [:pos :i64]
                         [:len :i64] [:want-end :bool]]]
             :pat/range [:record :pat/range
                         [[:prog :string] [:i :i64] [:n :i64] [:cp :i64]]]
             :pat/zeros [:record :pat/zeros [[:acc :string] [:n :i64]]]}))

;; --- hex ------------------------------------------------------------------

(defn hex-digit [cp :i64] :i64
  (if (< cp 48) -1
      (if (<= cp 57) (- cp 48)
          (if (< cp 97) -1
              (if (<= cp 102) (+ 10 (- cp 97)) -1)))))

(defn hex-scan [x [:ref :pat/hex]] :i64
  (let [s (record-get x :s)
        i (record-get x :i)
        n (record-get x :n)
        acc (record-get x :acc)]
    (if (<= n 0)
      acc
      (let [d (app (ref hex-digit) (string-code-point-at s i))]
        (if (< d 0)
          -1
          (app (ref hex-scan) (record-new [:ref :pat/hex] s (+ i 1) (- n 1) (+ (* acc 16) d))))))))

(defn hex-at [s :string i :i64 n :i64] :i64
  (app (ref hex-scan) (record-new [:ref :pat/hex] s i n 0)))

;; --- the program ----------------------------------------------------------

(defn prog-fold? [p :string] :bool
  (= 49 (string-code-point-at p 1)))

(defn prog-count [p :string] :i64
  (app (ref hex-at) p 2 6))

(defn range-count [p :string] :i64
  (app (ref hex-at) p 8 6))

(defn ins-off [i :i64] :i64
  (+ 14 (* i 14)))

(defn ins-op [p :string i :i64] :i64
  (app (ref hex-at) p (app (ref ins-off) i) 1))

(defn ins-a [p :string i :i64] :i64
  (app (ref hex-at) p (+ (app (ref ins-off) i) 1) 6))

(defn ins-b [p :string i :i64] :i64
  (app (ref hex-at) p (+ (app (ref ins-off) i) 7) 6))

(defn ins-c [p :string i :i64] :i64
  (app (ref hex-at) p (+ (app (ref ins-off) i) 13) 1))

(defn range-off [p :string r :i64] :i64
  (+ (+ 14 (* (app (ref prog-count) p) 14)) (* r 12)))

(defn range-lo [p :string r :i64] :i64
  (app (ref hex-at) p (app (ref range-off) p r) 6))

(defn range-hi [p :string r :i64] :i64
  (app (ref hex-at) p (+ (app (ref range-off) p r) 6) 6))

;; --- code points ----------------------------------------------------------

(defn fold-cp [cp :i64] :i64
  (if (>= cp 65) (if (<= cp 90) (+ cp 32) cp) cp))

(defn cp-width [cp :i64] :i64
  (if (< cp 128) 1 (if (< cp 2048) 2 (if (< cp 65536) 3 4))))

;; --- classes --------------------------------------------------------------

(defn range-hit? [x [:ref :pat/range]] :bool
  (let [prog (record-get x :prog)
        i (record-get x :i)
        n (record-get x :n)
        cp (record-get x :cp)]
    (if (<= n 0)
      false
      (if (if (>= cp (app (ref range-lo) prog i)) (<= cp (app (ref range-hi) prog i)) false)
        true
        (app (ref range-hit?) (record-new [:ref :pat/range] prog (+ i 1) (- n 1) cp))))))

(defn in-class? [p :string first :i64 count :i64 neg :i64 cp :i64] :bool
  (let [hit (app (ref range-hit?) (record-new [:ref :pat/range] p first count cp))]
    (if (= neg 1) (not hit) hit)))

;; --- the thread set -------------------------------------------------------
;;
;; One string, two sections: a BITSET of visited program counters followed by
;; the list of live ones, six hex digits each.
;;
;;   [ bits: ceil(nc/4) hex chars ][ pcs: 6 hex chars each ]
;;
;; Both sections are here for the same reason the program is a string: a
;; `:document` vector holds 32 items, and 32 simultaneously-live threads is a
;; real ceiling. Measured 2026-09-09: with the thread list as a document, the
;; 257-instruction email pattern from `kiyaku` answered `doc-vector-too-large`
;; on "a@b.co" while the 88-instruction IPv4 ran. Moving the PROGRAM out of a
;; document lifted one ceiling and left the next one standing behind it.
;;
;; The bitset is not an optimisation of taste. With membership as a linear
;; scan -- six hex digits decoded per entry -- that same email pattern took
;; **20.4 seconds** for one `match?` (measured, correct answer). A scan is
;; O(threads) FUNCTION ENTRIES per insert and fuel is charged per entry, so
;; the dedup that keeps a Pike VM linear was itself quadratic. A bit test is
;; one hex read and one mask.

(defn zeros [x [:ref :pat/zeros]] :string
  (let [acc (record-get x :acc)
        n (record-get x :n)]
    (if (<= n 0)
      acc
      (app (ref zeros) (record-new [:ref :pat/zeros] (string-concat acc "0") (- n 1))))))

(defn bits-len [prog :string] :i64
  (quot (+ (app (ref prog-count) prog) 3) 4))

(defn new-set [blen :i64] :string
  (app (ref zeros) (record-new [:ref :pat/zeros] "" blen)))

(defn hex-digit-char [d :i64] :string
  (if (< d 10)
    (string-from-i64 d)
    (if (= d 10) "a"
        (if (= d 11) "b"
            (if (= d 12) "c"
                (if (= d 13) "d"
                    (if (= d 14) "e" "f")))))))

;; `mod` is listed among the builtins and is not one here ("unknown operation:
;; mod is not a builtin, a sugar head, or a function of this module", measured
;; 2026-09-09), so the low bits are arithmetic.
(defn nibble [n :i64] :i64
  (- n (* 16 (quot n 16))))

(defn hex6 [n :i64] :string
  (string-concat
   (app (ref hex-digit-char) (quot n 1048576))
   (string-concat
    (app (ref hex-digit-char) (app (ref nibble) (quot n 65536)))
    (string-concat
     (app (ref hex-digit-char) (app (ref nibble) (quot n 4096)))
     (string-concat
      (app (ref hex-digit-char) (app (ref nibble) (quot n 256)))
      (string-concat
       (app (ref hex-digit-char) (app (ref nibble) (quot n 16)))
       (app (ref hex-digit-char) (app (ref nibble) n))))))))

;; `bit-shift-left` is not the name here -- the builtin is `i64-shift-left`
;; ("nearest defined: i32-shift-left (builtin), i64-shift-left (builtin)",
;; measured 2026-09-09). Four bits per hex digit, so the shift is 0..3.
;; Not a shift: `i64-shift-left` takes a LITERAL count in [0,63] (measured
;; 2026-09-09), and this one is computed. Four bits per hex digit, so the
;; whole domain is four values.
(defn bit-of [pc :i64] :i64
  (let [b (- pc (* 4 (quot pc 4)))]
    (if (= b 0) 1 (if (= b 1) 2 (if (= b 2) 4 8)))))

;; ⚠ Arithmetic, not `bit-and`/`bit-or`: those are refused by the JS backend
;; with "unsupported KIR operation" at the :kotoba-script phase (measured
;; 2026-09-09 — `string-from-i64` compiles there, the two bit heads do not).
;; For a hex digit d and a bit value v in {1,2,4,8}, the bit is set exactly
;; when (quot d v) is odd.
(defn bit-set? [d :i64 v :i64] :bool
  (= 1 (- (quot d v) (* 2 (quot d (* 2 v))))))

(defn set-has? [set :string pc :i64] :bool
  (app (ref bit-set?) (app (ref hex-at) set (quot pc 4) 1) (app (ref bit-of) pc)))

(defn set-add [set :string blen :i64 pc :i64] :string
  (let [at (quot pc 4)
        v (app (ref bit-of) pc)
        d (app (ref hex-at) set at 1)
        d2 (if (app (ref bit-set?) d v) d (+ d v))]
    (string-concat
     (string-concat (string-substring set 0 at) (app (ref hex-digit-char) d2))
     (string-concat (string-substring set (+ at 1) (string-length set))
                    (app (ref hex6) pc)))))

(defn thread-count [set :string blen :i64] :i64
  (quot (- (string-length set) blen) 6))

(defn pc-at [set :string blen :i64 i :i64] :i64
  (app (ref hex-at) set (+ blen (* i 6)) 6))

;; Epsilon closure: split, jmp and the anchors cost no input, so a thread that
;; lands on one keeps moving within the same step.
(defn add-thread [x [:ref :pat/add]] :string
  (let [prog (record-get x :prog)
        list (record-get x :list)
        pc (record-get x :pc)
        bol (record-get x :bol)
        eol (record-get x :eol)
        blen (record-get x :blen)]
    (if (if (app (ref set-has?) list pc) true (>= pc (app (ref prog-count) prog)))
      list
      (let [op (app (ref ins-op) prog pc)]
        (if (= op 4)
          (app (ref add-thread) (record-new [:ref :pat/add] prog list (app (ref ins-a) prog pc) bol eol blen))
          (if (= op 3)
            (app (ref add-thread)
                 (record-new [:ref :pat/add] prog
                             (app (ref add-thread)
                                  (record-new [:ref :pat/add] prog list (app (ref ins-a) prog pc) bol eol blen))
                             (app (ref ins-b) prog pc) bol eol blen))
            (if (= op 7)
              (if bol
                (app (ref add-thread) (record-new [:ref :pat/add] prog list (+ pc 1) bol eol blen))
                list)
              (if (= op 8)
                (if eol
                  (app (ref add-thread) (record-new [:ref :pat/add] prog list (+ pc 1) bol eol blen))
                  list)
                (app (ref set-add) list blen pc)))))))))

(defn start-list [prog :string bol :bool eol :bool blen :i64] :string
  (app (ref add-thread) (record-new [:ref :pat/add] prog (app (ref new-set) blen) 0 bol eol blen)))

;; --- one input position ---------------------------------------------------

(defn matches-here? [prog :string pc :i64 cp :i64] :bool
  (let [op (app (ref ins-op) prog pc)]
    (if (= op 2)
      true
      (if (= op 0)
        (if (app (ref prog-fold?) prog)
          (= (app (ref fold-cp) cp) (app (ref fold-cp) (app (ref ins-a) prog pc)))
          (= cp (app (ref ins-a) prog pc)))
        (if (= op 1)
          (let [first (app (ref ins-a) prog pc)
                count (app (ref ins-b) prog pc)
                neg (app (ref ins-c) prog pc)]
            (if (app (ref prog-fold?) prog)
              (if (app (ref in-class?) prog first count neg cp)
                true
                (app (ref in-class?) prog first count neg (app (ref fold-cp) cp)))
              (app (ref in-class?) prog first count neg cp)))
          false)))))

(defn any-match? [x [:ref :pat/threads]] :bool
  (let [prog (record-get x :prog)
        list (record-get x :list)
        i (record-get x :i)
        blen (record-get x :blen)]
    (if (>= i (app (ref thread-count) list blen))
      false
      (if (= 6 (app (ref ins-op) prog (app (ref pc-at) list blen i)))
        true
        (app (ref any-match?) (record-new [:ref :pat/threads] prog list (+ i 1) 0 "" blen false))))))

;; ⚠ `eol` is the flag for the position the surviving threads land ON, not the
;; one they left. Passing `false` here drops every thread that steps onto a `$`
;; -- which is every anchored pattern longer than one character.
;;
;; Measured 2026-09-09: `^(px|em)$` against "px" answered FALSE, and so did
;; `^[-+]?[0-9]+$` against "12", while `^a$` against "a" was right. The parity
;; corpus had no pattern ENDING in `$`, so 216 checks agreed with JavaScript
;; and none of them exercised this. The corpus now has four.
;;
;; An earlier shape tried to repair this after the fact by re-opening the
;; stepped list with eol=true; it cannot, because the thread was already gone.
(defn step-threads [x [:ref :pat/threads]] :string
  (let [prog (record-get x :prog)
        list (record-get x :list)
        i (record-get x :i)
        cp (record-get x :cp)
        next (record-get x :next)
        blen (record-get x :blen)
        eol (record-get x :eol)]
    (if (>= i (app (ref thread-count) list blen))
      next
      (let [pc (app (ref pc-at) list blen i)]
        (app (ref step-threads)
             (record-new [:ref :pat/threads] prog list (+ i 1) cp
                         (if (app (ref matches-here?) prog pc cp)
                           (app (ref add-thread)
                                (record-new [:ref :pat/add] prog next (+ pc 1) false eol blen))
                           next)
                         blen eol))))))

;; --- running --------------------------------------------------------------

(defn run-from [x [:ref :pat/run]] :i64
  (let [prog (record-get x :prog)
        list (record-get x :list)
        s (record-get x :s)
        pos (record-get x :pos)
        len (record-get x :len)
        blen (record-get x :blen)]
    (if (= 0 (app (ref thread-count) list blen))
      -1
      (let [here (if (app (ref any-match?)
                          (record-new [:ref :pat/threads] prog list 0 0 "" blen false))
                   pos
                   -1)]
        (if (>= pos len)
          here
          (let [cp (string-code-point-at s pos)
                nxt (+ pos (app (ref cp-width) cp))
                deeper (app (ref run-from)
                            (record-new [:ref :pat/run] prog
                                        (app (ref step-threads)
                                             (record-new [:ref :pat/threads] prog list 0 cp
                                                         (app (ref new-set) blen) blen (>= nxt len)))
                                        s nxt len blen))]
            (if (>= deeper 0) deeper here)))))))

(defn match-end-at [prog :string s :string pos :i64] :i64
  (let [len (string-length s)
        blen (app (ref bits-len) prog)]
    (app (ref run-from)
         (record-new [:ref :pat/run] prog
                     (app (ref start-list) prog (= pos 0) (>= pos len) blen)
                     s pos len blen))))

(defn match? [prog :string s :string] :bool
  (= (string-length s) (app (ref match-end-at) prog s 0)))

(defn scan-from [x [:ref :pat/scan]] :i64
  (let [prog (record-get x :prog)
        s (record-get x :s)
        pos (record-get x :pos)
        len (record-get x :len)
        want-end (record-get x :want-end)
        e (app (ref match-end-at) prog s pos)]
    (if (>= e 0)
      (if want-end e pos)
      (if (>= pos len)
        -1
        (app (ref scan-from)
             (record-new [:ref :pat/scan] prog s
                         (+ pos (app (ref cp-width) (string-code-point-at s pos)))
                         len want-end))))))

(defn search-start [prog :string s :string] :i64
  (app (ref scan-from) (record-new [:ref :pat/scan] prog s 0 (string-length s) false)))

(defn search-end [prog :string s :string] :i64
  (app (ref scan-from) (record-new [:ref :pat/scan] prog s 0 (string-length s) true)))

(defn search [prog :string s :string] :document
  (let [start (app (ref search-start) prog s)
        end (app (ref match-end-at) prog s start)]
    (if (< start 0)
      (document-null)
      (document-map :start (document-i64 start) :end (document-i64 end)))))

;; --- tests ----------------------------------------------------------------
;;
;; The programs are written out by hand, in the format itself. That is the
;; point: the machine is tested without the compiler, so a compiler bug cannot
;; make it look right. Each is annotated with the regex it encodes.

(defn p-ab [] :string
  ;; /ab/ : char 'a', char 'b', match
  (string-concat "K0" (string-concat "000003" (string-concat "000000"
    (string-concat "00000610000000" (string-concat "00000620000000" "60000000000000"))))))

(defn p-digit [] :string
  ;; /[0-9]/ : class(first 0, count 1, neg 0), match ; range 30-39
  (string-concat "K0" (string-concat "000002" (string-concat "000001"
    (string-concat "10000000000010" (string-concat "60000000000000" "000030000039"))))))

(defn p-digits [] :string
  ;; /[0-9]+/ : class, split(0,2), match
  (string-concat "K0" (string-concat "000003" (string-concat "000001"
    (string-concat "10000000000010"
      (string-concat "30000000000020" (string-concat "60000000000000" "000030000039")))))))

(defn p-a-or-b [] :string
  ;; /a|b/ : split(1,3) char a jmp(4) char b match
  (string-concat "K0" (string-concat "000005" (string-concat "000000"
    (string-concat "30000010000030"
      (string-concat "00000610000000"
        (string-concat "40000040000000"
          (string-concat "00000620000000" "60000000000000"))))))))

(defn p-anchored-a [] :string
  ;; /^a$/ : bol char a eol match
  (string-concat "K0" (string-concat "000004" (string-concat "000000"
    (string-concat "70000000000000"
      (string-concat "00000610000000"
        (string-concat "80000000000000" "60000000000000")))))))

(defn p-fold-a [] :string
  ;; /a/i
  (string-concat "K1" (string-concat "000002" (string-concat "000000"
    (string-concat "00000610000000" "60000000000000")))))

(defn p-nested [] :string
  ;; /(a+)+b/ : class a, split(0,2), split(0,3), char b, match ; range 61-61
  (string-concat "K0" (string-concat "000005" (string-concat "000001"
    (string-concat "10000000000010"
      (string-concat "30000000000020"
        (string-concat "30000000000030"
          (string-concat "00000620000000"
            (string-concat "60000000000000" "000061000061")))))))))

(defn test-hex [] :bool
  (and (= 0 (app (ref hex-at) "000000" 0 6))
       (= 97 (app (ref hex-at) "000061" 0 6))
       (= 255 (app (ref hex-at) "0000ff" 0 6))
       (= 1114111 (app (ref hex-at) "10ffff" 0 6))
       ;; a digit outside the alphabet answers -1 rather than a wrong number
       (= -1 (app (ref hex-at) "00zz00" 0 6))))

(defn test-header [] :bool
  (and (= 3 (app (ref prog-count) (p-ab)))
       (= 0 (app (ref range-count) (p-ab)))
       (= 1 (app (ref range-count) (p-digit)))
       (not (app (ref prog-fold?) (p-ab)))
       (app (ref prog-fold?) (p-fold-a))
       ;; the ranges sit after the code, so their offset moves with it
       (= 48 (app (ref range-lo) (p-digit) 0))
       (= 57 (app (ref range-hi) (p-digit) 0))))

(defn test-literal [] :bool
  (and (app (ref match?) (p-ab) "ab")
       (not (app (ref match?) (p-ab) "a"))
       (not (app (ref match?) (p-ab) "abc"))
       (not (app (ref match?) (p-ab) ""))
       (not (app (ref match?) (p-ab) "ba"))))

(defn test-class [] :bool
  (and (app (ref match?) (p-digit) "5")
       (app (ref match?) (p-digit) "0")
       (app (ref match?) (p-digit) "9")
       (not (app (ref match?) (p-digit) "/"))
       (not (app (ref match?) (p-digit) ":"))
       (not (app (ref match?) (p-digit) "a"))))

(defn test-quantifier [] :bool
  (and (app (ref match?) (p-digits) "0")
       (app (ref match?) (p-digits) "12345")
       (not (app (ref match?) (p-digits) ""))
       (not (app (ref match?) (p-digits) "12a"))))

(defn test-alternation [] :bool
  (and (app (ref match?) (p-a-or-b) "a")
       (app (ref match?) (p-a-or-b) "b")
       (not (app (ref match?) (p-a-or-b) "c"))
       (not (app (ref match?) (p-a-or-b) "ab"))))

(defn test-anchor [] :bool
  (and (app (ref match?) (p-anchored-a) "a")
       (not (app (ref match?) (p-anchored-a) "ba"))
       (not (app (ref match?) (p-anchored-a) "ab"))))

(defn test-search [] :bool
  (and (= 3 (app (ref search-start) (p-digits) "abc123"))
       (= 6 (app (ref search-end) (p-digits) "abc123"))
       (= 0 (app (ref search-start) (p-digits) "12ab34"))
       (= 2 (app (ref search-end) (p-digits) "12ab34"))
       (= -1 (app (ref search-start) (p-digits) "abc"))))

(defn test-fold [] :bool
  (and (app (ref match?) (p-fold-a) "A")
       (app (ref match?) (p-fold-a) "a")
       (not (app (ref match?) (p-ab) "AB"))))

(defn test-bounded [] :bool
  (and (not (app (ref match?) (p-nested) "aaaaaaaaaaaaaaaaaaaaaaaa"))
       (app (ref match?) (p-nested) "aaaaaaaaaaaaaaaaaaaaaaaab")))

(defn main []
  (app (ref prog-count) (p-ab)))
